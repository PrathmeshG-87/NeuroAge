APP_NAME=NeuroAge API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/neuroage
CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:3000,https://your-frontend.example.com
MODEL_SERVICE_URL=http://localhost:8001
MODEL_ARTIFACT_PATH=
MODEL_NAME=ResNet3D-Regression
MODEL_VERSION=unavailable
MODEL_EVALUATION_METRICS_PATH=
UPLOAD_DIRECTORY=./storage/uploads
REPORT_DIRECTORY=./storage/reports
DATASET_ROOT=./data/raw
DATASET_METADATA_PATH=./data/raw/metadata.csv
DATASET_DERIVED_DIR=./data/derived
MAX_UPLOAD_SIZE_BYTES=262144000
UPLOAD_RETENTION_DAYS=30
REPORT_RETENTION_DAYS=30
AUTHENTICATION_REQUIRED=true
AUTH_HEADER_NAME=X-User-Id
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=262144000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
